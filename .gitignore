
# Ignore all hidden files and directories in the root,
# except for the explicitly listed ones (e.g: .gitignore)
/.*
!.gitignore
!.gitmodules
!.github/

# OS system files
#
.DS_Store
.profile
Thumbs.db

# Editors' backup and temporary files
#
*.bak
*.tmp
*.kate-swp

# IDEs and editors
#
Xcodeproj/
.xcuserdata/
.vscode/
*.sublime-project
*.sublime-workspace

# Python
#
__pycache__/
venv/
venv-*/

# Node.js
#
node_modules/

# Style Galery thumbnail generator
#
/styles/src
/styles/samples_wf/*.png

# Images generated by the bulkgen script
/scripts/*.png

# Ignore files and directories ending with a tilde (~)
*~
*~.*
*~/
